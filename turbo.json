{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".b4/build/**", ".b4/b4.generated.d.ts"]
    },
    "@b4run/cli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/content/docs/**/*.mdx",
        "$TURBO_ROOT$/apps/web/app/components/docs/nav.ts"
      ],
      "outputs": ["dist/**", "docs/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/config-biome/biome.json"]
    },
    "test": {
      "dependsOn": ["build", "^test"]
    },
    "@b4run/cli#test": {
      "dependsOn": [
        "build",
        "^test",
        "@b4run/testing#build",
        "@b4run/postgres-storage#build",
        "@b4run/evals#build",
        "@b4run/memory-pgvector#build",
        "@b4run/devkit#build",
        "@b4run/vite-plugin#build",
        "@b4run/inspector#build",
        "create-b4-app#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/content/docs/**",
        "$TURBO_ROOT$/apps/web/app/components/docs/nav.ts",
        "$TURBO_ROOT$/packages/ag-ui/README.md",
        "$TURBO_ROOT$/examples/chat/**",
        "$TURBO_ROOT$/examples/research/**",
        "!$TURBO_ROOT$/examples/*/**/node_modules/**",
        "!$TURBO_ROOT$/examples/*/**/.b4/**",
        "!$TURBO_ROOT$/examples/*/**/.next/**",
        "!$TURBO_ROOT$/examples/*/**/.turbo/**",
        "!$TURBO_ROOT$/examples/*/**/dist/**",
        "!$TURBO_ROOT$/examples/*/**/*.tsbuildinfo"
      ]
    },
    "@b4run/core#test": {
      "dependsOn": ["build", "^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/vite-plugin/package.json",
        "$TURBO_ROOT$/test/fixtures/contracts/manifest.snap.json"
      ]
    },
    "@b4run/inspector#test": {
      "dependsOn": ["build", "^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/next.config.ts",
        "$TURBO_ROOT$/apps/web/next-env.d.ts",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/examples/chat/web/next.config.mjs",
        "$TURBO_ROOT$/examples/chat/web/package.json",
        "$TURBO_ROOT$/examples/research/web/next.config.mjs",
        "$TURBO_ROOT$/examples/research/web/package.json"
      ]
    },
    "@b4run/sandbox#test": {
      "dependsOn": ["build", "^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/kubernetes-compatibility.json",
        "$TURBO_ROOT$/.github/workflows/ci.yml",
        "$TURBO_ROOT$/charts/b4-sandbox-infra/values.yaml"
      ]
    },
    "@b4run/testing#test": {
      "dependsOn": ["build", "^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/memory/server/b4.config.ts",
        "$TURBO_ROOT$/examples/memory/server/package.json",
        "$TURBO_ROOT$/examples/memory/server/tsconfig.json",
        "$TURBO_ROOT$/examples/memory/server/src/**",
        "$TURBO_ROOT$/test/runtime/fixtures/sandbox-app/b4.config.ts",
        "$TURBO_ROOT$/test/runtime/fixtures/sandbox-app/package.json",
        "$TURBO_ROOT$/test/runtime/fixtures/sandbox-app/src/**"
      ]
    },
    "create-b4-app#test": {
      "dependsOn": ["build", "^test"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test/harness/**"]
    },
    "typecheck": {
      "dependsOn": ["build"]
    },
    "@b4run/cli#typecheck": {
      "dependsOn": ["build", "@b4run/testing#build", "@b4run/postgres-storage#build"]
    }
  }
}
