{
  "name": "@b4run/config-biome",
  "version": "0.8.26",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Shared Biome configuration for B4.run TypeScript workspace packages.",
  "keywords": [
    "b4",
    "biome",
    "linting",
    "formatting",
    "typescript",
    "configuration"
  ],
  "homepage": "https://github.com/cacheplane/b4run/tree/main/packages/config-biome#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/b4run.git",
    "directory": "packages/config-biome"
  },
  "bugs": {
    "url": "https://github.com/cacheplane/b4run/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "biome.json"
  ],
  "exports": {
    ".": "./biome.json",
    "./biome": "./biome.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "biome check --config-path ./biome.json ./biome.json",
    "lint": "biome check --config-path ../config-biome/biome.json package.json biome.json"
  }
}
