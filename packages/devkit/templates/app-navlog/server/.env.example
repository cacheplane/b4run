# Required only for live/model runs. Offline tests and evals replay recorded
# fixtures and need no API key.
OPENAI_API_KEY=
# aviationweather.gov needs no key. Override the base URL only for a local stub.
# B4_AWC_BASE_URL=https://aviationweather.gov/api/data

# Deployment only (main.mjs); leave unset for `b4 dev` and the tests.
# The secret the web proxy sends as X-Internal-Token: at least 32 characters
# (openssl rand -base64 32). With DATABASE_URL or RAILWAY_ENVIRONMENT set and no
# token, main.mjs refuses to boot unless B4_ALLOW_UNGUARDED=1.
# B4_INTERNAL_TOKEN=
# Postgres for the checkpointer, threads, permissions and memory stores.
# DATABASE_URL=
