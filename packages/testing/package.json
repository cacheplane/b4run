{
  "name": "@b4run/testing",
  "version": "0.8.31",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Deterministic harnesses, fixtures, and matchers for testing B4.run agent applications.",
  "keywords": [
    "b4",
    "typescript",
    "ai-agents",
    "testing",
    "fixtures",
    "llm"
  ],
  "homepage": "https://github.com/cacheplane/b4run/tree/main/packages/testing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/b4run.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/cacheplane/b4run/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "lint": "biome check --config-path ../config-biome/biome.json --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true --vcs-root=../../ package.json src test tsconfig.json tsconfig.build.json tsconfig.contracts.json vitest.config.ts",
    "test": "vitest --run --config vitest.config.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.contracts.json"
  },
  "dependencies": {
    "@copilotkit/aimock": "^1.37.4",
    "@b4run/memory": "workspace:*"
  },
  "peerDependencies": {
    "@b4run/cli": "workspace:*",
    "@b4run/core": "workspace:*",
    "@b4run/sdk": "workspace:*",
    "@b4run/workspace": "workspace:*"
  },
  "devDependencies": {
    "@b4run/cli": "workspace:*",
    "@b4run/config-typescript": "workspace:*",
    "@b4run/core": "workspace:*",
    "@b4run/langchain": "workspace:*",
    "@b4run/permissions": "workspace:*",
    "@b4run/sdk": "workspace:*",
    "@b4run/sqlite-storage": "workspace:*",
    "@b4run/workspace": "workspace:*",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "26.1.2",
    "zod": "^4.4.3"
  }
}
