{
  "name": "@b4-example/chat-web",
  "private": true,
  "version": "0.0.24",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\" && next build",
    "lint": "biome check --config-path ../../../packages/config-biome/biome.json package.json app e2e tsconfig.json next.config.mjs playwright.config.ts",
    "start": "next start -p 3000",
    "test:e2e": "playwright test --config playwright.config.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@copilotkit/react-core": "1.77.1",
    "@copilotkit/runtime": "1.77.1",
    "@b4run/ag-ui": "workspace:*",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@b4run/config-typescript": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2"
  }
}
