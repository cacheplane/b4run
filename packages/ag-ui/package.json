{
  "name": "@b4run/ag-ui",
  "version": "0.13.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "AG-UI protocol adapters for streaming B4.run agent runs to compatible clients.",
  "keywords": [
    "b4",
    "typescript",
    "langgraph",
    "ag-ui",
    "ai-agents",
    "streaming"
  ],
  "homepage": "https://github.com/cacheplane/b4run/tree/main/packages/ag-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/b4run.git",
    "directory": "packages/ag-ui"
  },
  "bugs": {
    "url": "https://github.com/cacheplane/b4run/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "default": "./dist/sse.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "default": "./dist/view/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/copilotkit": {
      "types": "./dist/react/copilotkit/index.d.ts",
      "default": "./dist/react/copilotkit/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/index.js"
    },
    "./angular/events": {
      "types": "./dist/angular/events/index.d.ts",
      "default": "./dist/angular/events/index.js"
    },
    "./angular/copilotkit": {
      "types": "./dist/angular/copilotkit/index.d.ts",
      "default": "./dist/angular/copilotkit/index.js"
    },
    "./copilotkit-runtime": {
      "types": "./dist/copilotkit-runtime/index.d.ts",
      "default": "./dist/copilotkit-runtime/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -b tsconfig.json && ngc -p tsconfig.angular.json && node -e \"require('node:fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "lint": "biome check --config-path ../config-biome/biome.json package.json scripts src test tsconfig.json tsconfig.test.json tsconfig.angular.json tsconfig.angular.test.json tsconfig.angular.spec.json vitest.config.ts vitest.angular.config.ts",
    "test": "vitest --run --config vitest.config.ts --passWithNoTests && vitest --run --config vitest.angular.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && ngc -p tsconfig.angular.test.json"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.2",
    "@ag-ui/encoder": "1.0.2",
    "@b4run/sdk": "workspace:*",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@ag-ui/client": ">=1.0.1 <2.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@copilotkit/angular": ">=0.5.3",
    "@copilotkit/react-core": ">=1.76.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@ag-ui/client": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "@copilotkit/angular": {
      "optional": true
    },
    "@copilotkit/react-core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/proto": "1.0.2",
    "@analogjs/vite-plugin-angular": "2.8.0",
    "@analogjs/vitest-angular": "2.8.0",
    "@angular/build": "22.2.1",
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@b4run/config-typescript": "workspace:*",
    "@copilotkit/angular": "0.5.3",
    "@copilotkit/react-core": "1.77.1",
    "@copilotkit/runtime": "1.77.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "axe-core": "4.14.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
