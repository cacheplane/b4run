{
  "name": "@b4run/devkit",
  "version": "0.8.31",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Scaffold templates and development utilities shared by B4.run tooling.",
  "keywords": [
    "b4",
    "typescript",
    "scaffolding",
    "templates",
    "developer-tools"
  ],
  "homepage": "https://github.com/cacheplane/b4run/tree/main/packages/devkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/b4run.git",
    "directory": "packages/devkit"
  },
  "bugs": {
    "url": "https://github.com/cacheplane/b4run/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "templates"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "lint": "biome check --config-path ../config-biome/biome.json --css-parse-tailwind-directives=true package.json src test templates tsconfig.json vitest.config.ts",
    "test": "vitest --run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@b4run/config-typescript": "workspace:*",
    "@types/node": "26.1.2"
  }
}
