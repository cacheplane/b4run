# Required only for live/model runs. Offline tests and evals replay recorded
# fixtures and need no API key.
OPENAI_API_KEY=
# aviationweather.gov needs no key. Override the base URL only for a local stub.
# B4_AWC_BASE_URL=https://aviationweather.gov/api/data

# Deployment only; leave unset for `b4 dev` and the tests.
# The secret the web proxy sends as X-Internal-Token: at least 32 characters
# (openssl rand -base64 32). With it set, route runs and thread routes refuse a
# call without it (src/auth.ts); /healthz and /memory/* do not. The B4.run
# repository's examples/navlog adds main.mjs, which requires it on every route
# and refuses to boot as a deployment without it unless B4_ALLOW_UNGUARDED=1.
# B4_INTERNAL_TOKEN=
# Postgres for the checkpointer, threads, permissions and memory stores.
# DATABASE_URL=
