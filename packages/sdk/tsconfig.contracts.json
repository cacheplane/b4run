{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "tsBuildInfoFile": "dist/tsconfig.contracts.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "test/*.contract.ts"]
}
