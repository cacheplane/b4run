{
  "name": "@b4run/langchain",
  "version": "0.8.28",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "LangChain adapters for B4.run agents, chains, tools, streaming, embeddings, and retry.",
  "keywords": [
    "b4",
    "typescript",
    "langchain",
    "langgraph",
    "ai-agents",
    "streaming"
  ],
  "homepage": "https://github.com/cacheplane/b4run/tree/main/packages/langchain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/b4run.git",
    "directory": "packages/langchain"
  },
  "bugs": {
    "url": "https://github.com/cacheplane/b4run/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#default-model-importer": {
      "types": "./dist/default-model-importer.d.ts",
      "b4-static-provider-imports": "./dist/static-model-importer.js",
      "default": "./dist/default-model-importer.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "lint": "biome check --config-path ../config-biome/biome.json package.json src test tsconfig.json tsconfig.test.json vitest.config.ts",
    "test": "vitest --run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@b4run/core": "workspace:*",
    "@b4run/sdk": "workspace:*",
    "@b4run/workspace": "workspace:*",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.5",
    "gpt-tokenizer": "^3.4.0"
  },
  "peerDependencies": {
    "@langchain/core": "^1.1.47",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/mistralai": "^1.2.0",
    "@langchain/groq": "^1.3.1",
    "@langchain/ollama": "^1.3.0",
    "@langchain/xai": "^1.4.5",
    "@langchain/openrouter": "^0.4.5"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph-checkpoint": {
      "optional": false
    },
    "@langchain/anthropic": {
      "optional": true
    },
    "@langchain/google-genai": {
      "optional": true
    },
    "@langchain/mistralai": {
      "optional": true
    },
    "@langchain/groq": {
      "optional": true
    },
    "@langchain/ollama": {
      "optional": true
    },
    "@langchain/xai": {
      "optional": true
    },
    "@langchain/openrouter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@b4run/config-typescript": "workspace:*",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/core": "1.2.5",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "1.4.9",
    "@langchain/mistralai": "^1.2.0",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "1.5.5",
    "@langchain/openrouter": "^0.4.5",
    "@langchain/xai": "^1.4.5",
    "@types/node": "26.1.2",
    "zod": "4.4.3"
  }
}
