{
  "$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/.dawn", "!scripts/release/terminal-records/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "overrides": [
    {
      "includes": [
        "scripts/release/recovery-platform-reviews/*.json",
        "scripts/release/recovery-fence-contracts/*.json",
        "scripts/release/recovery-fence-evidence/*.json",
        "scripts/release/recovery-adoptions/*.json"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
