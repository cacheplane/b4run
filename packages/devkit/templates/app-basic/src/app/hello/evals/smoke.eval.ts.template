import { contains, defineEval } from "@b4run/evals"
import { script } from "@b4run/testing"

export default defineEval({
  name: "greets by name",
  dataset: [
    {
      name: "ada",
      input: "Say hello to Ada",
      fixtures: script().user("Say hello to Ada").replies("Hello, Ada!"),
    },
  ],
  scorers: [contains("Hello", { threshold: 1 })],
  threshold: 1,
})
