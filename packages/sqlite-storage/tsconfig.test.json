{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": "../..",
    "tsBuildInfoFile": "dist/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "../../test/agent-protocol/runtime-storage-contract.ts",
    "../../test/agent-protocol/runtime-pending-identities.ts"
  ]
}
