# Where the B4.run server is. Local: the dev server; Vercel: the Railway service's public URL.
B4_SERVER_URL=http://127.0.0.1:3002

# Everything below is for the deployed demo and stays unset locally.

# Shared with the server's B4_INTERNAL_TOKEN (at least 32 characters: openssl rand -base64 32).
# Unset: the proxy injects nothing and the server guards nothing.
B4_INTERNAL_TOKEN=
# Comma-separated origins allowed to call the proxy, e.g. https://navlog.b4.run. Unset: no origin check.
B4_DEMO_ORIGINS=
# Upstash Redis for the rate limit (per visitor and per client IP). Unset: the proxy fails open.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Visiting /api/admin?token=<this> sets the demo-owner cookie that may approve memories.
# Long and random (openssl rand -base64 32); the cookie holds an HMAC of it. Unset: no owner route.
B4_DEMO_ADMIN_TOKEN=
