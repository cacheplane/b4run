{
  "name": "create-b4-app",
  "version": "0.8.27",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Scaffold a B4.run TypeScript agent application with supported starter templates.",
  "keywords": [
    "b4",
    "typescript",
    "langgraph",
    "ai-agents",
    "scaffolding",
    "create-app"
  ],
  "homepage": "https://github.com/cacheplane/b4run/tree/main/packages/create-b4-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/b4run.git",
    "directory": "packages/create-b4-app"
  },
  "bugs": {
    "url": "https://github.com/cacheplane/b4run/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "create-b4-app": "./dist/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "lint": "biome check --config-path ../config-biome/biome.json package.json src test tsconfig.json vitest.config.ts",
    "test": "vitest --run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p ../devkit/tsconfig.json && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@b4run/devkit": "workspace:*"
  },
  "devDependencies": {
    "@b4run/config-typescript": "workspace:*",
    "@types/node": "26.1.2"
  }
}
