  "definitions": {
    "AgentCapabilities": {
      "properties": [
        "custom",
        "execution",
        "humanInTheLoop",
        "identity",
        "multiAgent",
        "multimodal",
        "output",
        "reasoning",
        "state",
        "tools",
        "transport"
      ],
      "required": []
    },
    "IdentityCapabilities": {
      "properties": [
        "description",
        "documentationUrl",
        "metadata",
        "name",
        "provider",
        "type",
        "version"
      ],
      "required": []
    },
    "Metadata": {
      "properties": [],
      "required": []
    },
    "TransportCapabilities": {
      "properties": ["httpBinary", "pushNotifications", "resumable", "streaming", "websocket"],
      "required": []
    },
    "ToolsCapabilities": {
      "properties": ["clientProvided", "items", "parallelCalls", "supported"],
      "required": []
    },
    "Tool": {
      "properties": ["description", "metadata", "name", "parameters"],
      "required": ["description", "name"]
    },
    "OutputCapabilities": {
      "properties": ["structuredOutput", "supportedMimeTypes"],
      "required": []
    },
    "StateCapabilities": {
      "properties": ["deltas", "memory", "persistentState", "snapshots"],
      "required": []
    },
    "MultiAgentCapabilities": {
      "properties": ["delegation", "handoffs", "subagents", "supported"],
      "required": []
    },
    "SubagentInfo": {
      "properties": ["description", "name"],
      "required": ["name"]
    },
    "ReasoningCapabilities": {
      "properties": ["encrypted", "streaming", "supported"],
      "required": []
    },
    "MultimodalCapabilities": {
      "properties": ["input", "output"],
      "required": []
    },
    "MultimodalInputCapabilities": {
      "properties": ["audio", "file", "image", "pdf", "video"],
      "required": []
    },
    "MultimodalOutputCapabilities": {
      "properties": ["audio", "image"],
      "required": []
    },
    "ExecutionCapabilities": {
      "properties": ["codeExecution", "maxExecutionTime", "maxIterations", "sandboxed"],
      "required": []
    },
    "HumanInTheLoopCapabilities": {
      "properties": [
        "approvals",
        "approveWithEdits",
        "feedback",
        "interrupts",
        "interventions",
        "supported"
      ],
      "required": []
    }
