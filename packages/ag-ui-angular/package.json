{
  "name": "@b4run/ag-ui-angular",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The B4.run activity kit for Angular: standalone components that render a turn's steps, plan, reasoning, subagents and approvals.",
  "keywords": [
    "b4",
    "typescript",
    "angular",
    "ag-ui",
    "ai-agents"
  ],
  "homepage": "https://github.com/cacheplane/b4run/tree/main/packages/ag-ui-angular#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/b4run.git",
    "directory": "packages/ag-ui-angular"
  },
  "bugs": {
    "url": "https://github.com/cacheplane/b4run/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/types/b4run-ag-ui-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/b4run-ag-ui-angular.d.ts",
      "default": "./dist/fesm2022/b4run-ag-ui-angular.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && node scripts/copy-styles.mjs",
    "lint": "biome check --config-path ../config-biome/biome.json package.json ng-package.json scripts src test tsconfig.json tsconfig.lib.json tsconfig.spec.json vitest.config.ts",
    "test": "vitest --run --config vitest.config.ts",
    "typecheck": "ngc -p tsconfig.json"
  },
  "dependencies": {
    "@b4run/ag-ui": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.0",
    "@analogjs/vitest-angular": "2.8.0",
    "@angular/build": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@types/node": "26.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.0.1",
    "ng-packagr": "22.2.4",
    "typescript": "6.0.3"
  }
}
