{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "paths": {
      "@b4run/ag-ui": ["../ag-ui/src/index.ts"],
      "@b4run/core": ["../core/src/index.ts"],
      "@b4run/langchain": ["../langchain/src/index.ts"],
      "@b4run/langgraph": ["../langgraph/src/index.ts"],
      "@b4run/langgraph/*": ["../langgraph/src/*.ts"],
      "@b4run/memory": ["../memory/src/index.ts"],
      "@b4run/permissions": ["../permissions/src/index.ts"],
      "@b4run/sqlite-storage": ["../sqlite-storage/src/index.ts"]
    },
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../ag-ui"
    },
    {
      "path": "../core"
    },
    {
      "path": "../langchain"
    },
    {
      "path": "../langgraph"
    },
    {
      "path": "../memory"
    },
    {
      "path": "../permissions"
    },
    {
      "path": "../sqlite-storage"
    }
  ]
}
