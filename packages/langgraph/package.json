{
  "name": "@b4run/langgraph",
  "version": "0.8.28",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "LangGraph.js adapters and route contracts for B4.run agents, workflows, and graphs.",
  "keywords": [
    "b4",
    "typescript",
    "langgraph",
    "langgraphjs",
    "ai-agents",
    "workflows"
  ],
  "homepage": "https://github.com/cacheplane/b4run/tree/main/packages/langgraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/b4run.git",
    "directory": "packages/langgraph"
  },
  "bugs": {
    "url": "https://github.com/cacheplane/b4run/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define-entry": {
      "types": "./dist/define-entry.d.ts",
      "default": "./dist/define-entry.js"
    },
    "./route-module": {
      "types": "./dist/route-module.d.ts",
      "default": "./dist/route-module.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "lint": "biome check --config-path ../config-biome/biome.json package.json src test tsconfig.json vitest.config.ts",
    "test": "vitest --run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@b4run/sdk": "workspace:*"
  },
  "devDependencies": {
    "@b4run/config-typescript": "workspace:*",
    "@types/node": "26.1.2"
  }
}
