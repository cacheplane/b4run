{
  "name": "@b4run/sqlite-storage",
  "version": "0.8.28",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "SQLite persistence for B4.run checkpoints, Agent Protocol threads, and local state.",
  "keywords": [
    "b4",
    "typescript",
    "langgraph",
    "sqlite",
    "persistence",
    "ai-agents"
  ],
  "homepage": "https://github.com/cacheplane/b4run/tree/main/packages/sqlite-storage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/b4run.git",
    "directory": "packages/sqlite-storage"
  },
  "bugs": {
    "url": "https://github.com/cacheplane/b4run/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "lint": "biome check --config-path ../config-biome/biome.json package.json src test tsconfig.json vitest.config.ts",
    "test": "vitest --run --config vitest.config.ts --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph-checkpoint": "^1.1.3"
  },
  "devDependencies": {
    "@b4run/config-typescript": "workspace:*",
    "@langchain/core": "1.2.5",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@types/node": "26.1.2"
  }
}
