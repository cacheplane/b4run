{
  "name": "@b4run/vite-plugin",
  "version": "0.8.26",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Vite integration for B4.run route discovery and generated TypeScript types.",
  "keywords": [
    "b4",
    "typescript",
    "vite",
    "langgraph",
    "type-generation",
    "developer-tools"
  ],
  "homepage": "https://github.com/cacheplane/b4-run/tree/main/packages/vite-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/b4-run.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/cacheplane/b4-run/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "lint": "biome check --config-path ../config-biome/biome.json package.json src test tsconfig.json vitest.config.ts",
    "test": "vitest --run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@b4run/core": "workspace:*"
  },
  "devDependencies": {
    "@b4run/config-typescript": "workspace:*",
    "@types/node": "26.1.2",
    "vite": "6.4.3",
    "zod": "4.4.3"
  }
}
