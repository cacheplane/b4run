{
  "name": "{{appName}}-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "b4 dev --port 3002",
    "verify": "b4 verify",
    "typegen": "b4 typegen",
    "check": "b4 check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "b4 eval",
    "build": "b4 build",
    "start": "node --env-file-if-exists=.env .b4/build/server.mjs",
    "test:sandbox:docker": "B4_DEMO_DOCKER_SANDBOX=1 vitest run test/sandbox-docker.test.ts",
    "memory:list": "b4 memory list",
    "memory:approve": "b4 memory approve"
  },
  "dependencies": {
    "@b4run/cli": "{{b4CliSpecifier}}",
    "@b4run/langchain": "{{b4LangchainSpecifier}}",
    "@b4run/sandbox": "{{b4SandboxSpecifier}}",
    "@b4run/sdk": "{{b4SdkSpecifier}}",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@b4run/config-typescript": "{{b4ConfigTypescriptSpecifier}}",
    "@b4run/evals": "{{b4EvalsSpecifier}}",
    "@b4run/inspector": "{{b4InspectorSpecifier}}",
    "@b4run/testing": "{{b4TestingSpecifier}}",
    "@types/node": "25.6.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
