{
  "name": "@b4run/ag-ui",
  "version": "0.13.2",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "AG-UI protocol adapters for streaming B4.run agent runs to compatible clients.",
  "keywords": [
    "b4",
    "typescript",
    "langgraph",
    "ag-ui",
    "ai-agents",
    "streaming"
  ],
  "homepage": "https://github.com/cacheplane/b4run/tree/main/packages/ag-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/b4run.git",
    "directory": "packages/ag-ui"
  },
  "bugs": {
    "url": "https://github.com/cacheplane/b4run/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "default": "./dist/sse.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "default": "./dist/view/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/styles.css": "./dist/react/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"const fs = require('node:fs'); const path = require('node:path'); if (fs.existsSync('dist')) for (const entry of fs.readdirSync('dist', { withFileTypes: true })) if (entry.isFile() && /^(?:encode|run-input|translate)\\./.test(entry.name)) fs.rmSync(path.join('dist', entry.name))\" && tsc -b tsconfig.json && node -e \"const fs = require('node:fs'); fs.mkdirSync('dist/react', { recursive: true }); fs.copyFileSync('src/react/styles.css', 'dist/react/styles.css')\"",
    "lint": "biome check --config-path ../config-biome/biome.json package.json src test tsconfig.json vitest.config.ts",
    "test": "vitest --run --config vitest.config.ts --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.1",
    "@ag-ui/encoder": "1.0.1",
    "@b4run/sdk": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@ag-ui/client": ">=1.0.1 <2.0.0",
    "@copilotkit/react-core": ">=1.76.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@ag-ui/client": {
      "optional": true
    },
    "@copilotkit/react-core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/proto": "1.0.1",
    "@copilotkit/react-core": "1.76.0",
    "@b4run/config-typescript": "workspace:*",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rxjs": "7.8.1"
  }
}
